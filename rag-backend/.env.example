# Not needed for the default local setup (retrieverProvider=chroma, queryModel=local/*).
OPENAI_API_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local model servers (llama.cpp) + vector store. Defaults shown.
LOCAL_CHAT_URL=http://localhost:8081/v1
LOCAL_EMBEDDINGS_URL=http://localhost:8082/v1
LOCAL_EMBEDDING_MODEL=embeddinggemma
CHROMA_URL=http://localhost:8200
CHROMA_COLLECTION=daksha_documents

# Optional: LangSmith for tracing (recommended for development)
LANGCHAIN_TRACING_V2=false
# Optional: LangSmith API key to access deployed graph
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=ai-agent-pdf-chatbot
